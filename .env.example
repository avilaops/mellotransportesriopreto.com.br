# Copie para .env e preencha. Nunca commite o arquivo preenchido.

# Endereco do TMS que recebe cotacao, lead e consulta de rastreio.
# O site repassa /api/cotacoes, /api/leads e /api/rastreio para ca (next.config.ts).
# Producao: https://tms.avilaops.com. Sem valor, o site abre normalmente, mas
# esses tres envios respondem 404.
TMS_API_URL=https://tms.avilaops.com

# Google Tag Manager. Sem valor, o site usa o conteiner padrao da Mello.
NEXT_PUBLIC_GTM_ID=
